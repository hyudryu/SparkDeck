[Unit]
Description=VLLMController — vLLM/Ollama dashboard + OpenAI proxy on :7878
Documentation=https://github.com/anthropics/claude-code
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/hyudryu/VLLMController
ExecStart=/home/hyudryu/VLLMController/run.sh
Restart=always
RestartSec=5
# llama-server is spawned as a child process; KillMode=process lets it
# survive a controller restart so the controller can re-adopt it from
# data/llama_server.json instead of reloading the model.
KillMode=process
# vLLM containers can be slow to settle; give the controller time to come up.
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
